DTDC_TRACKING_URL=https://dtdcstagingapi.dtdc.com/dtdc-tracking-api
DTDC_API_KEY=
DTDC_TRACKING_TOKEN=
DTDC_CUSTOMER_CODE=
DTDC_SERVICE_TYPE=
# Commodity ID or accepted name, e.g. 84 = PLASTIC ITEMS, 43 = HOUSEHOLD GOODS.
DTDC_COMMODITY=
DTDC_ORIGIN_NAME=Tekgien Softwares
DTDC_ORIGIN_PHONE=9345266494
DTDC_ORIGIN_ADDRESS=34-h, fourth lane, swami nagar, salem road
DTDC_ORIGIN_PINCODE=637001
DTDC_ORIGIN_CITY=Namakkal
DTDC_ORIGIN_STATE=Tamil Nadu
